{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARKO Negocioncio a Ideoncio v1.0",
  "type": "object",
  "required": [
    "project_id",
    "version",
    "approval",
    "segments",
    "core_value_proposition",
    "problem_maps",
    "competitive_advantage",
    "offers",
    "commercial_rules",
    "messaging_constraints"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "approval": {
      "type": "object",
      "required": [
        "approved",
        "date"
      ],
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "date": {
          "type": "string"
        },
        "approved_by": {
          "type": "string"
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "context"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          }
        }
      }
    },
    "core_value_proposition": {
      "type": "string"
    },
    "problem_maps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "external_problem",
          "causes",
          "consequences",
          "desired_result",
          "service_response",
          "evidence_status"
        ],
        "properties": {
          "external_problem": {
            "type": "string"
          },
          "causes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consequences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "internal_problem": {
            "type": [
              "string",
              "null"
            ]
          },
          "desired_result": {
            "type": "string"
          },
          "service_response": {
            "type": "string"
          },
          "evidence_status": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "marketing_angles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "competitive_advantage": {
      "type": "object",
      "required": [
        "claim",
        "proof_or_source",
        "limits"
      ],
      "properties": {
        "claim": {
          "type": "string"
        },
        "proof_or_source": {
          "type": "string"
        },
        "limits": {
          "type": "string"
        }
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "price",
          "scope"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "commercial_rules": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "discount_policy": {
          "type": "string"
        },
        "excluded_offers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "messaging_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}