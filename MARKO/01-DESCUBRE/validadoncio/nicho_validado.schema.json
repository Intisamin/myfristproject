{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Salida de Validadoncio a Negocioncio",
  "type":"object",
  "required":["project_id","version","business_stage","geography","status","hypothesis","selected_niche","approval","evidence","critical_unknowns","next_tests"],
  "properties":{
    "project_id":{"type":"string"},"version":{"type":"string"},
    "business_stage":{"enum":["nuevo","existente","expansion"]},
    "geography":{"type":"string"},
    "status":{"enum":["APTO_PARA_DISEÑAR","APTO_CON_HIPOTESIS","VALIDACION_REQUERIDA","NO_RECOMENDADO_AHORA"]},
    "hypothesis":{"type":"string"},"selected_niche":{"type":["string","null"]},
    "approval":{"type":"object","required":["confirmed"],"properties":{"confirmed":{"type":"boolean"},"confirmed_by":{"type":["string","null"]},"date":{"type":["string","null"]}}},
    "evidence":{"type":"array","items":{"type":"object","required":["claim","kind","strength"],"properties":{"claim":{"type":"string"},"kind":{"enum":["observed","user_reported","inferred","hypothesis"]},"source":{"type":["string","null"]},"date":{"type":["string","null"]},"strength":{"enum":["alta","media","baja"]},"limitation":{"type":["string","null"]}}}},
    "critical_unknowns":{"type":"array","items":{"type":"string"}},
    "next_tests":{"type":"array","items":{"type":"object","required":["hypothesis","experiment","decision_rule"],"properties":{"hypothesis":{"type":"string"},"experiment":{"type":"string"},"decision_rule":{"type":"string"}}}}
  }
}
